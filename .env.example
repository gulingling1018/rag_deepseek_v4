DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENABLE_THINKING=false
RAG_TOP_K=5
RAG_MAX_HISTORY_MESSAGES=6
RAG_UPLOAD_DIR=./data/uploads
RAG_INDEX_DIR=./data/index
RAG_SESSIONS_PATH=./data/index/sessions.json
RAG_VECTOR_DIM=1024
RAG_HYBRID_BM25_WEIGHT=0.55
RAG_HYBRID_VECTOR_WEIGHT=0.45
RAG_RETRIEVAL_CANDIDATE_LIMIT=40
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_RERANK_PROVIDER=dashscope
RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_CANDIDATE_LIMIT=40
RAG_PDF_OCR_ENABLED=true
RAG_PDF_OCR_MODE=auto
RAG_PDF_OCR_DPI=200
RAG_PDF_OCR_QUALITY_THRESHOLD=0.72
